# Imagen de prueba del prototipo webprobe (Chromium sin pantalla + cliente estilo web).
FROM golang:1.26-alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /webprobe ./cmd/webprobe

# Chromium completo de Debian (no headless-shell): mismo motor y huella que un Chrome normal.
FROM debian:trixie-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends chromium fonts-dejavu-core fonts-liberation ca-certificates tzdata && \
    rm -rf /var/lib/apt/lists/* && \
    useradd -m -u 10001 app && \
    mkdir -p /data && chown app:app /data

COPY --from=builder /webprobe /usr/local/bin/webprobe

USER app
WORKDIR /data

ENTRYPOINT ["webprobe", "-chrome", "/usr/bin/chromium", "-no-sandbox", "-profile", "/data/profile"]
